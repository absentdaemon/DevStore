# ==============================================================================
# DevStore Supabase Configuration Example
# ==============================================================================
# Copy this file to .env (for local servers) or copy config.example.js to config.js
# (for browser client integration).
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your real .env or config.js file to GitHub.
# 2. ONLY use the PUBLIC 'anon' key in client-facing web applications.
# 3. NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend code or browser sessions.
# ==============================================================================

# Supabase Project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (safe for browsers with RLS enabled)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# DevStore Local HTTP Server Port
PORT=3000
